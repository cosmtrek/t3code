#!/usr/bin/env python3
"""Release the fork and switch this machine's t3 service to a fork release. See FORK.md, Releases.

  t3fork release [--android [patch|minor|X.Y.Z]] [--no-desktop] [--version X.Y.Z-r.N] [--dry-run] [--watch]
  t3fork upgrade [X.Y.Z-r.N]   # default: latest fork release; runs detached, the service restart cuts this agent turn
  t3fork status
"""
import argparse, datetime, json, os, re, subprocess, sys, time

REPO = "cosmtrek/t3code"
CHECKOUT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
BRANCH = "r/main"
BASE_URL = f"https://github.com/{REPO}/releases/download"
STATE = os.path.expanduser("~/.t3/runtime/service-state.json")
LOGDIR = os.path.expanduser("~/.t3/logs")


def sh(*cmd, check=True, cwd=None):
    r = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)
    if check and r.returncode:
        sys.exit(f"t3fork: `{' '.join(cmd)}` failed:\n{r.stderr.strip() or r.stdout.strip()}")
    return r.stdout.strip()


def gh_json(*args):
    return json.loads(sh("gh", *args, "-R", REPO) or "null")


def latest_release():
    rows = gh_json("release", "list", "-L", "20", "--json", "tagName,isDraft,publishedAt")
    tags = [r["tagName"] for r in rows if not r["isDraft"] and re.fullmatch(r"v\d+\.\d+\.\d+-r\.\d+", r["tagName"])]
    return tags[0][1:] if tags else None


def upstream_base():
    tag = sh("git", "describe", "--tags", "--abbrev=0", "--match", "v[0-9]*.[0-9]*.[0-9]*", "--exclude", "*-*",
             f"origin/{BRANCH}", cwd=CHECKOUT)
    return tag[1:]


def next_version():
    base, last = upstream_base(), latest_release()
    if last and last.split("-r.")[0] == base:
        return f"{base}-r.{int(last.split('-r.')[1]) + 1}", last
    return f"{base}-r.1", last


def last_android():
    runs = gh_json("run", "list", "-w", "fork-android-apk.yml", "-L", "20", "--json", "databaseId,conclusion")
    for r in runs:
        if r["conclusion"] != "success":
            continue
        names = json.loads(sh("gh", "api", f"repos/{REPO}/actions/runs/{r['databaseId']}/artifacts", "-q",
                              "[.artifacts[].name]"))
        for n in names:
            m = re.search(r"production-(\d+)\.(\d+)\.(\d+)-", n)
            if m:
                return tuple(map(int, m.groups()))
    return None


def typical_minutes(workflow):
    runs = gh_json("run", "list", "-w", workflow, "-L", "10", "--json", "conclusion,createdAt,updatedAt")
    mins = []
    for r in runs:
        if r["conclusion"] == "success":
            a, b = (datetime.datetime.fromisoformat(r[k].replace("Z", "+00:00")) for k in ("createdAt", "updatedAt"))
            mins.append((b - a).total_seconds() / 60)
    return round(sorted(mins)[len(mins) // 2]) if mins else None


def check_pushed():
    sh("git", "fetch", "-q", "origin", BRANCH, "--tags", cwd=CHECKOUT)
    local = sh("git", "rev-parse", BRANCH, cwd=CHECKOUT)
    remote = sh("git", "rev-parse", f"origin/{BRANCH}", cwd=CHECKOUT)
    if local != remote:
        ahead = sh("git", "rev-list", "--count", f"origin/{BRANCH}..{BRANCH}", cwd=CHECKOUT)
        behind = sh("git", "rev-list", "--count", f"{BRANCH}..origin/{BRANCH}", cwd=CHECKOUT)
        sys.exit(f"t3fork: local {BRANCH} differs from origin (ahead {ahead}, behind {behind}). "
                 f"Push or pull first; the workflow builds origin/{BRANCH}.")
    return remote[:10]


def dispatch(workflow, fields):
    since = datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(seconds=5)
    args = ["workflow", "run", workflow, "--ref", BRANCH]
    for k, v in fields.items():
        args += ["-f", f"{k}={v}"]
    sh("gh", *args, "-R", REPO)
    for _ in range(20):
        time.sleep(3)
        runs = gh_json("run", "list", "-w", workflow, "-L", "5", "--json", "databaseId,createdAt,url")
        new = [r for r in runs if datetime.datetime.fromisoformat(r["createdAt"].replace("Z", "+00:00")) >= since]
        if new:
            return new[-1]
    sys.exit(f"t3fork: dispatched {workflow} but could not find its run; check `gh run list -w {workflow}`")


def cmd_release(a):
    head = check_pushed()
    version, last = (a.version, latest_release()) if a.version else next_version()
    apk = None
    plan = [("fork-cli-release.yml", {"version": version, "desktop": str(not a.no_desktop).lower()})]
    if a.android is not None:
        prev = last_android()
        if re.fullmatch(r"\d+\.\d+\.\d+", a.android):
            mv = a.android
        elif prev is None:
            sys.exit("t3fork: no previous Android build found; pass --android X.Y.Z")
        elif a.android == "minor":
            mv = f"{prev[0]}.{prev[1] + 1}.0"
        else:
            mv = f"{prev[0]}.{prev[1]}.{prev[2] + 1}"
        plan.append(("fork-android-apk.yml", {"version": mv, "variant": "production", "abi": "arm64-v8a"}))
        apk = f"{BASE_URL}/android-v{mv}/t3code-production-{mv}-arm64-v8a.apk"
    print(f"origin/{BRANCH} {head}; last fork release {last or '-'} -> {version}")
    for wf, f in plan:
        print(f"  {wf} {f}  (typically ~{typical_minutes(wf) or '?'} min)")
    if apk:
        print(f"  android apk once built: {apk}")
    if a.dry_run:
        return
    runs = [(wf, dispatch(wf, f)) for wf, f in plan]
    for wf, r in runs:
        print(f"started {wf}: {r['url']}")
    if not a.watch:
        print("Wait with: gh run watch <id> -R cosmtrek/t3code --exit-status (run it in the background).")
        return
    failed = False
    for wf, r in runs:
        rc = subprocess.run(["gh", "run", "watch", str(r["databaseId"]), "-R", REPO, "--exit-status",
                             "--interval", "30"], stdout=subprocess.DEVNULL).returncode
        print(f"{wf}: {'success' if rc == 0 else 'FAILED'} {r['url']}")
        failed |= rc != 0
    if not failed:
        print(f"release: https://github.com/{REPO}/releases/tag/v{version}")
        if apk:
            print(f"android apk (open on the phone to install): {apk}")
    sys.exit(1 if failed else 0)


def active():
    try:
        return json.load(open(STATE)).get("activeVersion")
    except OSError:
        return None


def cmd_upgrade(a):
    version = a.version or latest_release()
    if not version:
        sys.exit("t3fork: no fork release found")
    cur = active()
    if cur == version:
        print(f"already on {version}")
        return
    os.makedirs(LOGDIR, exist_ok=True)
    log = os.path.join(LOGDIR, f"t3fork-upgrade-{version}.log")
    unit = f"t3fork-upgrade-{int(time.time())}"
    extra = ["--allow-downgrade"] if a.allow_downgrade else []
    t3 = os.path.expanduser("~/.local/bin/t3")
    inner = f"{t3} update {version} --yes {' '.join(extra)} > {log} 2>&1"
    sh("systemd-run", "--user", f"--unit={unit}", "--collect", "-E", f"T3CODE_RELEASE_BASE_URL={BASE_URL}",
       "-E", f"HOME={os.path.expanduser('~')}", "/bin/bash", "-c", inner)
    print(f"upgrade {cur} -> {version} started detached (unit {unit}, log {log}).")
    print("The t3 service restarts in about a minute and cuts this agent turn; T3 resumes it automatically.")
    print("After the resume run `t3fork status` once to confirm. Do not rerun the upgrade.")


def cmd_status(a):
    print("active:", active())
    print("latest fork release:", latest_release())
    print("service:", sh("systemctl", "--user", "show", "t3code.service", "-p", "ActiveState,SubState,ActiveEnterTimestamp",
                         "--value", check=False).replace("\n", " "))
    logs = sorted((os.path.join(LOGDIR, f) for f in os.listdir(LOGDIR) if f.startswith("t3fork-upgrade-")),
                  key=os.path.getmtime) if os.path.isdir(LOGDIR) else []
    if logs:
        print(f"last upgrade log {logs[-1]}:")
        print("  " + "\n  ".join(open(logs[-1], errors="replace").read().strip().splitlines()[-5:]))


p = argparse.ArgumentParser(prog="t3fork", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
s = p.add_subparsers(dest="cmd", required=True)
r = s.add_parser("release")
r.add_argument("--android", nargs="?", const="patch", help="also build Android production: patch (default), minor or X.Y.Z")
r.add_argument("--no-desktop", action="store_true")
r.add_argument("--version", help="override X.Y.Z-r.N")
r.add_argument("--dry-run", action="store_true")
r.add_argument("--watch", action="store_true", help="block until all runs finish (run in background)")
r.set_defaults(fn=cmd_release)
u = s.add_parser("upgrade")
u.add_argument("version", nargs="?")
u.add_argument("--allow-downgrade", action="store_true")
u.set_defaults(fn=cmd_upgrade)
s.add_parser("status").set_defaults(fn=cmd_status)
a = p.parse_args()
a.fn(a)
